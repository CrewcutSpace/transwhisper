# Copy to .env and adjust. All values are optional.

# Audio
INPUT_DEVICE=BlackHole
SILENCE_THRESHOLD=0.003

# Streaming
PARTIAL_STEP_SECONDS=0.4
PAUSE_SECONDS=0.6
MAX_SEGMENT_SECONDS=12

# Transcription
MODEL_SIZE=base
WHISPER_THREADS=8
SOURCE_LANG=en

# Translation
TARGET_LANG=uk
# TRANSLATE_BACKEND=argos
# DEEPL_API_KEY=

# Overlay
SHOW_ORIGINAL=0
