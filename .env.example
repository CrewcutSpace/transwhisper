# Copy to .env and adjust. All values are optional.

# Audio
AUDIO_SOURCE=tap
# INPUT_DEVICE=BlackHole
SILENCE_THRESHOLD=0.003

# Streaming
PARTIAL_STEP_SECONDS=0.4
PAUSE_SECONDS=0.6
MAX_SEGMENT_SECONDS=12

# Transcription
MODEL_SIZE=small
WHISPER_THREADS=8
SOURCE_LANG=en

# Translation
TARGET_LANG=uk
# TRANSLATE_BACKEND=apple
# LIVE_BACKEND=auto
# DEEPL_API_KEY=

# Overlay
FOLLOW_WINDOW=Meet,Zoom,Teams
SHOW_IN_DOCK=1
SHOW_ORIGINAL=0
