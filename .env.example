# Copy to .env and adjust. All values are optional.

# Audio
AUDIO_SOURCE=tap
# INPUT_DEVICE=BlackHole
SILENCE_THRESHOLD=0.003

# Streaming
PARTIAL_STEP_SECONDS=0.4
PAUSE_SECONDS=0.6
JOIN_PAUSE_SECONDS=3
MAX_SEGMENT_SECONDS=12

# Transcription
MODEL_SIZE=small
WHISPER_THREADS=8
SOURCE_LANG=en

# Translation
TARGET_LANG=uk
# TRANSLATE_BACKEND=apple   # apple | ollama | argos | deepl
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_URL=http://localhost:11434
# LIVE_BACKEND=auto
# DEEPL_API_KEY=

# Overlay
FOLLOW_WINDOW=Meet,Zoom,Teams,Safari,Chrome,Brave,Arc,Firefox,Edge
SHOW_IN_DOCK=0
SHOW_ORIGINAL=1

# Saving the conversation (off by default; also --save or the menu bar item)
SAVE_TRANSCRIPT=0
# TRANSCRIPT_DIR=~/Documents/transwhisper
